import os

# Gitee AI-only runtime configuration.  Keep the real API key in the process
# environment or Docker .env file; never put it in this file or the image.
MODEL_ROOT_PATH = ""
GITEE_AI_API_BASE_URL = os.getenv("GITEE_AI_API_BASE_URL", "https://ai.gitee.com/v1")
GITEE_AI_API_KEY = os.getenv("GITEE_AI_API_KEY", "")
GITEE_AI_CHAT_MODEL = os.getenv("GITEE_AI_CHAT_MODEL", "Qwen2.5-72B-Instruct")
GITEE_AI_EMBEDDING_MODEL = os.getenv("GITEE_AI_EMBEDDING_MODEL", "bce-embedding-base_v1")

# Knowledge-base creation, retrieval and chat all use this online provider.
EMBEDDING_MODEL = "gitee-ai"
EMBEDDING_DEVICE = "auto"
RERANKER_MODEL = ""
USE_RERANKER = False
RERANKER_MAX_LENGTH = 1024
EMBEDDING_KEYWORD_FILE = "keywords.txt"
EMBEDDING_MODEL_OUTPUT_PATH = "output"

LLM_MODELS = ["gitee-ai"]
Agent_MODEL = None
LLM_DEVICE = "auto"
HISTORY_LEN = 3
MAX_TOKENS = None
TEMPERATURE = 0.7

ONLINE_LLM_MODEL = {
    "gitee-ai": {
        "model_name": GITEE_AI_CHAT_MODEL,
        "embed_model": GITEE_AI_EMBEDDING_MODEL,
        "api_base_url": GITEE_AI_API_BASE_URL,
        "api_key": GITEE_AI_API_KEY,
        "provider": "OpenAIWorker",
        "openai_proxy": "",
    },
}

# No local models are registered in this delivery.
MODEL_PATH = {
    "embed_model": {},
    "llm_model": {},
    "reranker": {},
}
NLTK_DATA_PATH = os.path.join(os.path.dirname(os.path.dirname(__file__)), "nltk_data")
VLLM_MODEL_DICT = {}
SUPPORT_AGENT_MODEL = ["gitee-ai"]
