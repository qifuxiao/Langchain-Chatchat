import os

# API-only deployment: model weights are hosted by the API server.
MODEL_ROOT_PATH = ""
EMBEDDING_MODEL = "openai-api"
EMBEDDING_DEVICE = "cpu"
LLM_MODELS = ["openai"]
LLM_DEVICE = "cpu"
Agent_MODEL = None
HISTORY_LEN = 3
MAX_TOKENS = None
TEMPERATURE = 0.7

# The existing reranker implementation loads a local CrossEncoder; keep disabled.
# A remote rerank service requires its own protocol adapter before enabling it.
RERANKER_MODEL = ""
USE_RERANKER = False
RERANKER_MAX_LENGTH = 1024
EMBEDDING_KEYWORD_FILE = "keywords.txt"
EMBEDDING_MODEL_OUTPUT_PATH = "output"

# Use reachable intranet endpoints on an offline server. Never put API keys in images.
# GITEE_AI_* aliases also support the existing Compose configuration.
_API_BASE = os.getenv("OPENAI_API_BASE_URL", os.getenv("GITEE_AI_API_BASE_URL", "https://ai.gitee.com/v1"))
_API_KEY = os.getenv("OPENAI_API_KEY", os.getenv("GITEE_AI_API_KEY", ""))
_CHAT_MODEL = os.getenv("OPENAI_CHAT_MODEL", os.getenv("GITEE_AI_CHAT_MODEL", "glm-4-9b-chat"))
_EMBED_MODEL = os.getenv("OPENAI_EMBEDDING_MODEL", os.getenv("GITEE_AI_EMBEDDING_MODEL", "Qwen3-Embedding-8B"))

ONLINE_LLM_MODEL = {
    "openai": {
        "model_name": _CHAT_MODEL,
        "api_base_url": _API_BASE,
        "api_key": _API_KEY,
        "embed_model": _EMBED_MODEL,
        "provider": "OpenAIWorker",
    },
    # This key is required by the embedding adapter in server/embeddings_api.py.
    "openai-api": {
        "model_name": _CHAT_MODEL,
        "api_base_url": os.getenv("OPENAI_EMBEDDING_API_BASE_URL", _API_BASE),
        "api_key": os.getenv("OPENAI_EMBEDDING_API_KEY", _API_KEY),
        "embed_model": _EMBED_MODEL,
        "provider": "OpenAIWorker",
    },
}

# Empty local registries prevent API aliases being mistaken for local weights.
MODEL_PATH = {"embed_model": {}, "llm_model": {}, "reranker": {}}
VLLM_MODEL_DICT = {}
NLTK_DATA_PATH = os.path.join(os.path.dirname(os.path.dirname(__file__)), "nltk_data")
SUPPORT_AGENT_MODEL = ["openai", "openai-api"]
