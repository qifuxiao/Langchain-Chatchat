# Copy this file to .env and set the Gitee AI token. Do not commit .env.
GITEE_AI_API_KEY=

# Override these only when your Gitee AI account is authorized for different models.
GITEE_AI_API_BASE_URL=https://ai.gitee.com/v1
GITEE_AI_CHAT_MODEL=Qwen2.5-72B-Instruct
GITEE_AI_EMBEDDING_MODEL=bce-embedding-base_v1
