# Copy this file to .env and set the value locally. Never include the real key
# in the image, Dockerfile, compose file, or source control.
GITEE_AI_API_KEY=
GITEE_AI_API_BASE_URL=https://ai.gitee.com/v1
GITEE_AI_CHAT_MODEL=Qwen2-7B-Instruct
GITEE_AI_EMBEDDING_MODEL=Qwen3-Embedding-8B
GITEE_AI_RERANKER_MODEL=Qwen3-Reranker-8B

# Build-time package mirrors. Change these when you have an internal mirror.
APT_MIRROR_HOST=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
