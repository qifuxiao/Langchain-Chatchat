# Copy to .env on the deployment host and set the endpoint/key.
# An intranet OpenAI-compatible server works without public Internet access.
OPENAI_API_BASE_URL=https://ai.gitee.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=glm-4-9b-chat
OPENAI_EMBEDDING_MODEL=Qwen3-Embedding-8B
# If embeddings use a different server/key, uncomment and configure:
# OPENAI_EMBEDDING_API_BASE_URL=http://embedding-server:8000/v1
# OPENAI_EMBEDDING_API_KEY=
