# Langchain-Chatchat 配置 (支持 ai.gitee.com)

# =================== Gitee AI 配置 ===================
# Gitee AI API 地址 (通常不需要修改)
GITEE_BASE_URL=https://ai.gitee.com/v1

# Gitee AI API Key (必填，从 https://ai.gitee.com/ 获取)
GITEE_API_KEY=your-gitee-api-key-here

# Gitee AI LLM 模型列表 (用逗号分隔)
GITEE_LLM_MODELS=Qwen2-72B-Instruct,Qwen2-7B-Instruct,GLM-4-Flash,GLM-4V-Flash

# Gitee AI Embedding 模型列表 (用逗号分隔)
GITEE_EMBED_MODELS=embedding-2

# =================== 默认模型配置 ===================
# 默认使用的 LLM 模型 (必须在上面的列表中)
DEFAULT_LLM_MODEL=Qwen2-72B-Instruct

# 默认使用的 Embedding 模型
DEFAULT_EMBEDDING_MODEL=embedding-2

# =================== 其他配置 ===================
# 日志详细模式 (true/false)
LOG_VERBOSE=false

# HTTP 请求超时时间 (秒)
HTTPX_DEFAULT_TIMEOUT=300
